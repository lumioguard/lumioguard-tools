{
  "name": "lumioguard-tools",
  "private": true,
  "version": "0.14.0",
  "description": "A home for URL-only tools that read a public website and report something true about it. Each tool is a detection engine, a Worker and a client; they share the contracts, tokens and surface in packages/.",
  "keywords": [
    "website-audit",
    "static-analysis",
    "security-scanner",
    "cloudflare-workers",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/lumioguard-dev/lumioguard-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumioguard-dev/lumioguard-tools.git"
  },
  "bugs": {
    "url": "https://github.com/lumioguard-dev/lumioguard-tools/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "turbo run dev",
    "deploy": "turbo run deploy",
    "rules": "node scripts/build-rule-catalog.mjs",
    "rules:check": "node scripts/build-rule-catalog.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.2",
    "turbo": "^2.10.11",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@biomejs/biome": "1.9.4"
    }
  }
}
