{
  "name": "@lumioguard/slopmeter-api",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Slopmeter scan API: fetching, screenshots and the clock. Cloudflare Worker.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node ../../../scripts/dev-worker.mjs slopmeter",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ../../../scripts/deploy-worker.mjs slopmeter",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumioguard/api-core": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "@lumioguard/slopmeter-core": "workspace:*",
    "hono": "~4.12.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
