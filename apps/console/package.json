{
  "name": "@lumioguard/console",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "The one surface. Reads a site with every tool you pick and lands them on a single verdict.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=lumioguard-readout --branch=main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lumioguard/design-tokens": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "@lumioguard/ui": "workspace:*",
    "@lumioguard/web-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
