{
  "name": "@lumioguard/console",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "The one surface. Reads a site with every tool you pick and lands them on a single verdict.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=lumioguard-readout --branch=main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lumioguard/design-tokens": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "@lumioguard/ui": "workspace:*",
    "@lumioguard/web-core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
